stateDiagram-v2
    state "0 上电默认，实际在跑识别" as T0
    state "1 收到开始命令，空操作" as T1
    state "2 停止，不处理不发帧" as T2
    state "3 阈值调节界面" as T3
    [*] --> T0
    T0 --> T1: 串口 55 01
    T0 --> T2: 串口 55 02
    T0 --> T3: 按键 GPIO53 或 串口 55 03
    T1 --> T2: 串口 55 02
    T1 --> T3: 按键 或 串口 55 03
    T2 --> T1: 串口 55 01
    T2 --> T3: 按键 或 串口 55 03
    T3 --> T0: 界面返回
